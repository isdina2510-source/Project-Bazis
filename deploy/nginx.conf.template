# Шаблон. Не правьте домены здесь: готовый файл deploy/generated/nginx.conf создаёт команда
#   npm run deploy:config
# Домены берутся из SITE_DOMAIN (или SITE_URL / MEDIA_SITE_URL) в .env, порт — из PORT.
# SITE_DOMAIN=dinarabi.com даёт server_name dinarabi.com (+ media.dinarabi.com, если включён медиасайт).
# www.<домен> — 301 на https://<apex>$request_uri (блоки WWW_REDIRECT_BLOCKS; если www нет — пусто).
#
# nginx перед server.js: HTTPS, редирект с HTTP и передача адреса посетителя.
# Сертификаты Let's Encrypt (один на все домены):
#   sudo certbot certonly --webroot -w /var/www/certbot --cert-name {{CERT_NAME}} {{CERTBOT_DOMAINS}}

upstream dinarabi_node {
  server 127.0.0.1:{{PORT}};
  keepalive 16;
}

{{WWW_REDIRECT_BLOCKS}}
# HTTP только перенаправляет на HTTPS (и отдаёт проверку certbot).
server {
  listen 80;
  listen [::]:80;
  server_name {{NGINX_HOSTS}};

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }
  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  # Ubuntu 24.04 nginx 1.24: HTTP/2 через флаг listen (директива "http2 on" — с 1.25.1).
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name {{NGINX_HOSTS}};

  ssl_certificate     /etc/letsencrypt/live/{{CERT_NAME}}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/{{CERT_NAME}}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:10m;

  # Браузер запомнит, что сайт только HTTPS (пароль админки не уйдёт по HTTP даже по старой ссылке).
  # Остальные заголовки безопасности (CSP, X-Frame-Options, Referrer-Policy…) отдаёт сам server.js
  # (security/headers.js); add_header их бы задублировал, а у админки X-Frame-Options свой — DENY.
  # HSTS server.js тоже присылает, поэтому от него скрываем копию и ставим здесь — и на ответах с ошибкой nginx.
  proxy_hide_header Strict-Transport-Security;
  add_header Strict-Transport-Security "max-age=31536000" always;

  # Вложения в ИИ-чат — до 12 МБ, картинки товаров — до 2.5 МБ.
  client_max_body_size 13m;

  # Видео в «Примеры работ» из админки — до 100 МБ; передаём серверу потоком, не копя на диске nginx.
  location = /api/portfolio/upload {
    client_max_body_size 101m;
    proxy_request_buffering off;
    proxy_pass http://dinarabi_node;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
  }

  location / {
    proxy_pass http://dinarabi_node;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    # Только настоящий адрес соединения: присланный посетителем X-Forwarded-For не передаём.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Ответ ИИ может идти до 45 с.
    proxy_read_timeout 90s;
  }
}
