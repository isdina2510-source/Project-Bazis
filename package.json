{
  "name": "bazis-site",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "description": "Сайт ИП Базис с CRM заказов (React + Vite)",
  "scripts": {
    "predev": "npm run images",
    "dev": "vite",
    "dev:media": "vite --mode media",
    "prebuild": "npm run images",
    "build": "vite build && vite build --mode media",
    "build:bazis": "vite build",
    "build:media": "vite build --mode media",
    "images": "node scripts/images.mjs",
    "preview": "npm run build && node server.js",
    "start": "node server.js",
    "server": "node server.js",
    "test": "node --test \"ai/test/*.test.js\" \"antispam/test/*.test.js\" \"auth/test/*.test.js\" \"config/test/*.test.js\" \"db/test/*.test.js\" \"documents/test/*.test.js\" \"logging/test/*.test.js\" \"notify/test/*.test.js\" \"security/test/*.test.js\" \"test/*.test.js\"",
    "check:prod": "node server.js --check-config --production",
    "deploy:config": "node scripts/deploy-config.mjs",
    "fonts": "node scripts/fonts.mjs",
    "i18n:check": "node scripts/i18n-check.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "intl-messageformat": "^12.1.2",
    "lenis": "^1.3.26",
    "nodemailer": "^10.0.15",
    "pdfmake": "^0.3.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.5",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "fontkit": "^2.0.4",
    "subset-font": "^2.9.0",
    "vite": "^8.3.2"
  }
}
